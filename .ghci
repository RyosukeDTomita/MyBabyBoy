-- プロジェクト用 GHCi 設定。`nix develop --command ghci` で起動すると読み込まれる。
:set -isrc
:set -XOverloadedStrings

-- src/Month0.hs を読み込んでエクスポート関数をスコープに入れる。
-- (未ロードの home モジュールは import だけでは入らないため :add を使う)
:add Month0
-- :add は *Month0 をスコープに入れ Test.Hspec の describe と衝突するため外し、
-- test/Spec.hs と同じく下の import(hiding / qualified)経由で見せる。
:module - *Month0

-- このプロジェクト(src/app/test)で実際に使うモジュールだけを import する。
-- (.ghci は ImportQualifiedPost を有効にしていないため qualified は前置形で書く)
import Control.Monad.IO.Class (liftIO)
import Month0 hiding (describe)
import qualified Month0
import Options.Declarative
import Test.Hspec
